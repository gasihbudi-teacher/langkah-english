{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["quizId", "sections"],
  "properties": {
    "quizId": {"type": "string", "minLength": 1},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["passageId", "entries"],
        "properties": {
          "passageId": {"type": "string", "minLength": 1},
          "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["expression", "meaningId", "level", "priority"],
              "properties": {
                "expression": {"type": "string", "pattern": "\\S"},
                "meaningId": {"type": "string", "pattern": "\\S"},
                "level": {"enum": ["Pre-A1", "A1", "A2", "B1", "B2", "C1", "C2"]},
                "priority": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
