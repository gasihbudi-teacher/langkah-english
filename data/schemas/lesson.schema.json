{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "objectives",
    "blocks",
    "practice",
    "assessments"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "const": "heading"
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "const": "subheading"
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "const": "text"
              },
              "text": {
                "type": "string"
              },
              "idText": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "const": "rule"
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "const": "example"
              },
              "text": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "incorrect",
              "correct",
              "explanation"
            ],
            "properties": {
              "type": {
                "const": "mistake"
              },
              "incorrect": {
                "type": "string"
              },
              "correct": {
                "type": "string"
              },
              "explanation": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "headers",
              "rows"
            ],
            "properties": {
              "type": {
                "const": "table"
              },
              "headers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "title",
              "items"
            ],
            "properties": {
              "type": {
                "const": "vocabulary"
              },
              "title": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "english",
                    "indonesian"
                  ],
                  "properties": {
                    "english": {
                      "type": "string",
                      "minLength": 1
                    },
                    "indonesian": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "title",
              "items",
              "collapsed"
            ],
            "properties": {
              "type": {
                "const": "example_group"
              },
              "title": {
                "type": "string"
              },
              "collapsed": {
                "type": "boolean"
              },
              "items": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "english",
                    "indonesian",
                    "note"
                  ],
                  "properties": {
                    "english": {
                      "type": "string",
                      "minLength": 1
                    },
                    "indonesian": {
                      "type": "string",
                      "minLength": 1
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "sentence",
              "parts"
            ],
            "properties": {
              "type": {
                "const": "breakdown"
              },
              "sentence": {
                "type": "string"
              },
              "parts": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "english",
                    "meaning"
                  ],
                  "properties": {
                    "english": {
                      "type": "string"
                    },
                    "meaning": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "title",
              "items"
            ],
            "properties": {
              "type": {
                "const": "summary"
              },
              "title": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "intro",
              "steps"
            ],
            "properties": {
              "type": {
                "const": "scaffold"
              },
              "intro": {
                "type": "string",
                "minLength": 10
              },
              "steps": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "required": [
                    "title",
                    "explanation"
                  ],
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "explanation": {
                      "type": "string"
                    },
                    "english": {
                      "type": "string"
                    },
                    "indonesian": {
                      "type": "string"
                    },
                    "why": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "id",
              "prompt",
              "translation",
              "choices",
              "answer",
              "explanation",
              "hint",
              "translationChoices"
            ],
            "properties": {
              "type": {
                "const": "checkpoint"
              },
              "id": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "translation": {
                "type": "string"
              },
              "choices": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "string"
                }
              },
              "answer": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "explanation": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              },
              "translationChoices": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "prompt",
              "translation",
              "answer"
            ],
            "properties": {
              "type": {
                "const": "reflection"
              },
              "prompt": {
                "type": "string"
              },
              "translation": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "practice": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "prompt",
          "choices",
          "answer",
          "explanation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "choices": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "answer": {
            "type": "integer",
            "minimum": 0
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "passageId": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "skill": {
            "type": "string"
          },
          "translationId": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string"
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
